    },
    {
      "name": "02 - Full Platform Kafka E2E",
      "item": [
        {
          "name": "1. Create Order (Use ADMIN Token for Current Backend)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{orderBaseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{productId}},\n      \"quantity\": {{quantity}}\n    }\n  ],\n  \"shippingAddress\": {\n    \"customerName\": \"Karan Test\",\n    \"customerEmail\": \"karan.test@example.com\",\n    \"customerPhone\": \"9999999999\",\n    \"line1\": \"Test Address Line 1\",\n    \"line2\": \"Near Test Landmark\",\n    \"city\": \"Ludhiana\",\n    \"state\": \"Punjab\",\n    \"pincode\": \"141001\",\n    \"country\": \"India\"\n  },\n  \"paymentMethod\": \"GOOGLE_PAY\",\n  \"shippingFee\": 50.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Assumes productId exists and has stock. This uses the ADMIN token because the current Order -> Product internal snapshot call may reject a normal USER token until service-to-service authentication is fixed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order created', function () { pm.response.to.have.status(201); });",
                  "const d=pm.response.json(); pm.collectionVariables.set('integratedOrderId', d.id); pm.collectionVariables.set('integratedOrderNumber', d.orderNumber);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get Payment By Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{paymentBaseUrl}}/admin/payments/order/{{integratedOrderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Kafka processing is asynchronous. Wait 2-5 seconds after creating the order if this initially returns 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment record exists', function () { pm.response.to.have.status(200); });",
                  "const d=pm.response.json(); pm.collectionVariables.set('integratedPaymentReference', d.paymentReference);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Mark Payment Success",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{paymentBaseUrl}}/admin/payments/{{integratedPaymentReference}}/mock-success",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gatewayReference\": \"GATEWAY-{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Payment marked successful', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('SUCCEEDED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Verify Order Reaches SHIPMENT_CREATED",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{orderBaseUrl}}/admin/orders/{{integratedOrderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "description": "Wait 3-8 seconds after payment success. Inventory must reserve stock, Order Service must publish OrderConfirmed, and Shipping Service must publish ShipmentCreated. A second run should show SHIPMENT_CREATED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Order received shipping event', function () { pm.response.to.have.status(200); const d=pm.response.json(); pm.expect(['CONFIRMED','SHIPMENT_CREATED']).to.include(d.status); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Get Automatically Created Shipment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{shippingBaseUrl}}/admin/shipments/order/{{integratedOrderId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Shipping service consumed OrderConfirmed', function () { pm.response.to.have.status(200); const d=pm.response.json(); pm.expect(d.status).to.eql('CREATED'); pm.collectionVariables.set('integratedShipmentId', d.id); pm.collectionVariables.set('integratedTrackingNumber', d.trackingNumber); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Mark Integrated Shipment IN_TRANSIT",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{shippingBaseUrl}}/admin/shipments/{{integratedShipmentId}}/status",
            "body": {
