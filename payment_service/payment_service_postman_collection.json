{
  "info": {
    "name": "Payment Service - Local Google Pay Flow",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "payment_base_url", "value": "http://localhost:8085" },
    { "key": "USER_TOKEN", "value": "" },
    { "key": "ADMIN_TOKEN", "value": "" },
    { "key": "paymentReference", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{payment_base_url}}/actuator/health"
      }
    },
    {
      "name": "User - Get My Payments",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
        ],
        "url": "{{payment_base_url}}/payments/me?page=0&size=20"
      }
    },
    {
      "name": "User - Get Payment By Reference",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
        ],
        "url": "{{payment_base_url}}/payments/{{paymentReference}}"
      }
    },
    {
      "name": "User - Redirect To Google Pay UPI",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{USER_TOKEN}}" }
        ],
        "url": "{{payment_base_url}}/payments/{{paymentReference}}/redirect"
      }
    },
    {
      "name": "Admin - List Payments",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
        ],
        "url": "{{payment_base_url}}/admin/payments?page=0&size=20"
      }
    },
    {
      "name": "Admin - Get Payment By Reference",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
        ],
        "url": "{{payment_base_url}}/admin/payments/{{paymentReference}}"
      }
    },
    {
      "name": "Admin - Get Payment By Order Id",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" }
        ],
        "url": "{{payment_base_url}}/admin/payments/order/{{orderId}}"
      }
    },
    {
      "name": "Admin - Mock Payment Success",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gatewayReference\": \"LOCAL-GPAY-TEST-001\"\n}"
        },
        "url": "{{payment_base_url}}/admin/payments/{{paymentReference}}/mock-success"
      }
    },
    {
      "name": "Admin - Mock Payment Failure",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"failureReason\": \"Customer cancelled payment in Google Pay\"\n}"
        },
        "url": "{{payment_base_url}}/admin/payments/{{paymentReference}}/mock-failure"
      }
    },
    {
      "name": "Admin - Refund Payment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{ADMIN_TOKEN}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 100.00,\n  \"reason\": \"Customer requested refund\"\n}"
        },
        "url": "{{payment_base_url}}/admin/payments/{{paymentReference}}/refunds"
      }
    }
  ]
}
