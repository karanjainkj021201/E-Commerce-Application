              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{expiry_order_id}},\n  \"orderNumber\": \"ORD-EXPIRY-{{expiry_order_id}}\",\n  \"warehouseCode\": \"WH-DEFAULT\",\n  \"items\": [\n    {\n      \"productId\": {{product_id}},\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now() + 1;",
                  "pm.collectionVariables.set('expiry_order_id', id.toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expiry reservation created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('RESERVED');",
                  "  pm.collectionVariables.set('expiry_reservation_number', body.reservationNumber);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Direct Expire Before Due - Negative Test",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations/{{expiry_reservation_number}}/expire",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "internal",
                "inventory",
                "reservations",
                "{{expiry_reservation_number}}",
                "expire"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Early expiry is rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Run Due Expiry Scan",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations/expire-due",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "internal",
                "inventory",
                "reservations",
                "expire-due"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Expiry scan completed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('expiredCount');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Expiry Reservation by Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/admin/inventory/reservations/order/{{expiry_order_id}}",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "admin",
                "inventory",
                "reservations",
                "order",
                "{{expiry_order_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation is visible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(['RESERVED','EXPIRED']).to.include(pm.response.json().status);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
