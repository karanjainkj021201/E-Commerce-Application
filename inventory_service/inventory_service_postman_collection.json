      "name": "05 - Negative Tests",
      "item": [
        {
          "name": "Insufficient Stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations",
              "host": [
                "{{inventory_base}}"
              ],
