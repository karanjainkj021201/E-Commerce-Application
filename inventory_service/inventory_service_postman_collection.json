    {
      "name": "02 - Reserve, Commit, and Restock",
      "item": [
        {
          "name": "Create Temporary Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "internal",
                "inventory",
                "reservations"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{manual_order_id}},\n  \"orderNumber\": \"ORD-MANUAL-{{manual_order_id}}\",\n  \"warehouseCode\": \"WH-DEFAULT\",\n  \"items\": [\n    {\n      \"productId\": {{product_id}},\n      \"sku\": \"{{sku}}\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now();",
                  "pm.collectionVariables.set('manual_order_id', id.toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation created', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('RESERVED');",
                  "  pm.expect(body.expiresAt).to.not.be.null;",
                  "  pm.collectionVariables.set('reservation_number', body.reservationNumber);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Reservation by Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/admin/inventory/reservations/order/{{manual_order_id}}",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "admin",
                "inventory",
                "reservations",
                "order",
                "{{manual_order_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation is RESERVED', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('RESERVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Reservation by Number",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/admin/inventory/reservations/{{reservation_number}}",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "admin",
                "inventory",
                "reservations",
                "{{reservation_number}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Commit Reservation",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations/{{reservation_number}}/commit",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "internal",
                "inventory",
                "reservations",
                "{{reservation_number}}",
                "commit"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reservation committed', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('COMMITTED');",
                  "  pm.expect(body.committedAt).to.not.be.null;",
                  "  pm.expect(body.expiresAt).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Stock after Commit",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/admin/inventory/stocks/{{stock_id}}",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "admin",
                "inventory",
                "stocks",
                "{{stock_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Release Committed Reservation (Restock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations/{{reservation_number}}/release",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "internal",
                "inventory",
                "reservations",
                "{{reservation_number}}",
                "release"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Postman cancellation after commit\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Committed stock restored', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('RELEASED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Stock after Restock",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{inventory_base}}/admin/inventory/stocks/{{stock_id}}",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "admin",
                "inventory",
                "stocks",
                "{{stock_id}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{admin_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Expiry (use 1-minute test configuration)",
      "description": "Create the reservation, wait past expiresAt, then run the due-expiry scan.",
      "item": [
        {
          "name": "Create Reservation for Expiry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{inventory_base}}/internal/inventory/reservations",
              "host": [
                "{{inventory_base}}"
              ],
              "path": [
                "internal",
                "inventory",
                "reservations"
